@model DLAttendance.ViewModels.PaginationViewModel

@if (Model.TotalCount > 0)
{
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3">
        <div class="text-muted small">
            Showing @Model.StartRecord–@Model.EndRecord of @Model.TotalCount
        </div>
        <div class="d-flex align-items-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <label class="form-label mb-0 small text-nowrap" for="pageSizeSelect">Page size</label>
                <select id="pageSizeSelect" class="form-select form-select-sm page-size-select" style="width:auto">
                    @foreach (var size in DLAttendance.ViewModels.Paging.AllowedPageSizes)
                    {
                        if (size == Model.PageSize)
                        {
                            <option value="@size" selected>@size</option>
                        }
                        else
                        {
                            <option value="@size">@size</option>
                        }
                    }
                </select>
            </div>
            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0">
                        @{
                            // Build Previous URL
                            var prevRouteVals = new Dictionary<string, string?>(Model.RouteValues)
                            {
                                ["page"] = (Model.Page - 1).ToString(),
                                ["pageSize"] = Model.PageSize.ToString()
                            };
                            var nextRouteVals = new Dictionary<string, string?>(Model.RouteValues)
                            {
                                ["page"] = (Model.Page + 1).ToString(),
                                ["pageSize"] = Model.PageSize.ToString()
                            };
                        }
                        <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                            @if (Model.HasPrevious)
                            {
                                <a class="page-link" asp-controller="@Model.Controller" asp-action="@Model.Action"
                                   asp-all-route-data="prevRouteVals">Previous</a>
                            }
                            else
                            {
                                <span class="page-link">Previous</span>
                            }
                        </li>
                        @{
                            var startPage = Math.Max(1, Model.Page - 2);
                            var endPage = Math.Min(Model.TotalPages, Model.Page + 2);
                        }
                        @for (var p = startPage; p <= endPage; p++)
                        {
                            var pageRouteVals = new Dictionary<string, string?>(Model.RouteValues)
                            {
                                ["page"] = p.ToString(),
                                ["pageSize"] = Model.PageSize.ToString()
                            };
                            <li class="page-item @(p == Model.Page ? "active" : "")">
                                <a class="page-link" asp-controller="@Model.Controller" asp-action="@Model.Action"
                                   asp-all-route-data="pageRouteVals">@p</a>
                            </li>
                        }
                        <li class="page-item @(Model.HasNext ? "" : "disabled")">
                            @if (Model.HasNext)
                            {
                                <a class="page-link" asp-controller="@Model.Controller" asp-action="@Model.Action"
                                   asp-all-route-data="nextRouteVals">Next</a>
                            }
                            else
                            {
                                <span class="page-link">Next</span>
                            }
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
}
