@model DLAttendance.Models.Device

@{
    ViewData["Title"] = "Delete Device";
}

<h2>Delete Device</h2>

<div class="alert alert-warning">
    Are you sure you want to delete this device?
</div>

<dl class="row">
    <dt class="col-sm-3">Device Name</dt>
    <dd class="col-sm-9">@Model.DeviceName</dd>

    <dt class="col-sm-3">IP Address</dt>
    <dd class="col-sm-9">@Model.IpAddress</dd>

    <dt class="col-sm-3">Serial Number</dt>
    <dd class="col-sm-9">@Model.SerialNumber</dd>

    <dt class="col-sm-3">Location</dt>
    <dd class="col-sm-9">@Model.Location</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>
</form>