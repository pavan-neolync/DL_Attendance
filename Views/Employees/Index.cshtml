@model DLAttendance.ViewModels.EmployeeIndexViewModel

@{
    ViewData["Title"] = "DL Employees";
    var isAdmin = User.IsInRole("Admin");
    var canManageEmployees = isAdmin || User.IsInRole("HR");
    var hiddenValue = "*****";
    var paged = Model.PagedEmployees;
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h3 mb-0">DL Employee Master</h1>
        <div class="text-muted">Employee data imported from APEX DL Master Data.</div>
    </div>
    @if (canManageEmployees)
    {
        <a asp-action="Create" class="btn btn-primary">Add Employee</a>
    }
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-info">@message</div>
}

<form method="get" class="border rounded p-3 mb-3 bg-light" data-auto-search>
    <input type="hidden" name="page" value="@paged.Page" />
    <input type="hidden" name="pageSize" value="@paged.PageSize" />
    <div class="row g-2 align-items-end">
        <div class="col-md-10">
            <label class="form-label" for="search">Search</label>
            <input class="form-control" id="search" name="search" value="@Model.Search" placeholder="Employee ID, name, BU, vendor, category" />
        </div>
        <div class="col-md-2 d-grid">
            <button class="btn btn-outline-secondary" type="button" data-clear-filters>Clear</button>
        </div>
    </div>
</form>

<div class="d-flex flex-wrap gap-2 mb-3">
    @if (canManageEmployees)
    {
        <a class="btn btn-success" asp-action="Export" asp-route-search="@Model.Search">Export Excel</a>
    }
    @if (isAdmin)
    {
        <form asp-action="Import" method="post" enctype="multipart/form-data" class="d-flex flex-wrap gap-2">
            @Html.AntiForgeryToken()
            <input type="file" name="file" accept=".xlsx" class="form-control" />
            <button class="btn btn-outline-success" type="submit">Upload APEX Master</button>
        </form>
    }
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle employee-master-table">
        <thead>
            <tr>
                <th>Employee ID</th>
                <th>Name</th>
                <th>BU</th>
                <th>Gender</th>
                <th>Birth Date</th>
                <th>Age</th>
                <th>Join Date</th>
                <th>Aadhaar</th>
                <th>UAN</th>
                <th>ESIC Number</th>
                <th>Bank Name</th>
                <th>Account Number</th>
                <th>IFSC Code</th>
                <th>Vendor</th>
                <th>Category</th>
                <th>Mobile Number</th>
                @if (canManageEmployees)
                {
                    <th class="text-end employee-actions-col">Actions</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in paged.Items)
            {
                <tr>
                    <td>@item.EmployeeCode</td>
                    <td>@item.Name</td>
                    <td>@item.BuName</td>
                    <td>@item.Gender</td>
                    <td>@item.BirthDate?.ToString("yyyy-MM-dd")</td>
                    <td>@item.Age</td>
                    <td>@item.JoinDate?.ToString("yyyy-MM-dd")</td>
                    <td>@(isAdmin? item.Aadhaar: hiddenValue)</td>
                    <td>@(isAdmin? item.Uan: hiddenValue)</td>
                    <td>@item.EsicNumber</td>
                    <td>@item.BankName</td>
                    <td>@item.AccountNumber</td>
                    <td>@item.IfscCode</td>
                    <td>@item.Vendor</td>
                    <td>@item.Category</td>
                    <td>@item.MobileNumber</td>
                    @if (canManageEmployees)
                    {
                        <td class="text-end employee-actions-col">
                            <div class="d-flex justify-content-end gap-1">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            </div>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!paged.Items.Any())
{
    <div class="alert alert-secondary">No employees found.</div>
}

@{
    var pagination = new PaginationViewModel
    {
        Page = paged.Page,
        PageSize = paged.PageSize,
        TotalCount = paged.TotalCount,
        Controller = "Employees",
        RouteValues = new Dictionary<string, string?> { ["search"] = Model.Search }
    };
}
<partial name="_Pagination" model="pagination" />
