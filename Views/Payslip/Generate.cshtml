@model DLAttendance.ViewModels.PayslipGenerateViewModel

@{
    ViewData["Title"] = "Generate Payslip";
}

<h1 class="h3 mb-3">Generate Payslip</h1>

<form asp-action="Generate" method="post" class="border rounded p-3 bg-white">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="Month" class="form-label"></label>
            <select asp-for="Month" class="form-select">
                @for (var m = 1; m <= 12; m++)
                {
                    <option value="@m">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label asp-for="Year" class="form-label"></label>
            <input asp-for="Year" class="form-control" type="number" />
        </div>
        <div class="col-md-4 d-flex align-items-end">
            <div class="form-check">
                <input asp-for="GenerateForAll" class="form-check-input" />
                <label asp-for="GenerateForAll" class="form-check-label"></label>
            </div>
        </div>
        <div class="col-md-8" id="employeeSelect">
            <label asp-for="DlEmployeeId" class="form-label"></label>
            <select asp-for="DlEmployeeId" class="form-select" asp-items="ViewBag.Employees">
                <option value="">Select employee</option>
            </select>
            <span asp-validation-for="DlEmployeeId" class="text-danger"></span>
        </div>
    </div>

    <hr class="my-4" />
    <h2 class="h5">Earnings (Monthly Rates)</h2>
    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="BasicRate" class="form-label"></label>
            <input asp-for="BasicRate" class="form-control" type="number" step="0.01" />
        </div>
        <div class="col-md-4">
            <label asp-for="HraRate" class="form-label"></label>
            <input asp-for="HraRate" class="form-control" type="number" step="0.01" />
        </div>
        <div class="col-md-4">
            <label asp-for="SpecialAllowanceRate" class="form-label"></label>
            <input asp-for="SpecialAllowanceRate" class="form-control" type="number" step="0.01" />
        </div>
    </div>

    <hr class="my-4" />
    <h2 class="h5">Deductions</h2>
    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="PfDeduction" class="form-label"></label>
            <input asp-for="PfDeduction" class="form-control" type="number" step="0.01" />
        </div>
        <div class="col-md-4">
            <label asp-for="VpfDeduction" class="form-label"></label>
            <input asp-for="VpfDeduction" class="form-control" type="number" step="0.01" />
        </div>
        <div class="col-md-4">
            <label asp-for="IncomeTaxDeduction" class="form-label"></label>
            <input asp-for="IncomeTaxDeduction" class="form-control" type="number" step="0.01" />
        </div>
        <div class="col-md-4">
            <label asp-for="ProfessionTaxDeduction" class="form-label"></label>
            <input asp-for="ProfessionTaxDeduction" class="form-control" type="number" step="0.01" />
        </div>
        <div class="col-md-4">
            <label asp-for="EsicDeduction" class="form-label"></label>
            <input asp-for="EsicDeduction" class="form-control" type="number" step="0.01" />
        </div>
    </div>

    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">Generate</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const allCheckbox = document.getElementById('GenerateForAll');
            const employeeSelect = document.getElementById('employeeSelect');
            const toggle = () => {
                employeeSelect.style.display = allCheckbox.checked ? 'none' : 'block';
            };
            allCheckbox.addEventListener('change', toggle);
            toggle();
        })();
    </script>
}
