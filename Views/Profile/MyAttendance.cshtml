@model DLAttendance.ViewModels.AttendanceIndexViewModel
@using DLAttendance.Models

@{
    ViewData["Title"] = "My Attendance";
    var paged = Model.PagedRecords;
}

<div class="mb-3">
    <h1 class="h3 mb-0">My Attendance</h1>
    <div class="text-muted">Your attendance records.</div>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-info">@message</div>
}

<form method="get" class="border rounded p-3 mb-3 bg-light">
    <input type="hidden" name="page" value="1" />
    <input type="hidden" name="pageSize" value="@paged.PageSize" />
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label">From Date</label>
            <input class="form-control" name="fromDate" type="date" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-3">
            <label class="form-label">To Date</label>
            <input class="form-control" name="toDate" type="date" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Status</label>
            <select class="form-select" name="status">
                <option value="">All</option>
                @foreach (var item in Html.GetEnumSelectList<AttendanceStatus>())
                {
                    <option value="@item.Text" selected="@(item.Text == Model.Status)">@item.Text</option>
                }
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button class="btn btn-primary" type="submit">Filter</button>
            <a class="btn btn-outline-secondary" asp-action="MyAttendance">Clear</a>
        </div>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Date</th>
                <th>Shift</th>
                <th>Status</th>
                <th>In</th>
                <th>Out</th>
                <th>Working Hours</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in paged.Items)
            {
                <tr>
                    <td>@item.WorkDate.ToString("dd-MMM-yyyy")</td>
                    <td>@item.Shift</td>
                    <td>
                        @{
                            var badgeClass = item.Status switch
                            {
                                AttendanceStatus.Present => "bg-success",
                                AttendanceStatus.Absent => "bg-danger",
                                AttendanceStatus.Leave => "bg-warning text-dark",
                                AttendanceStatus.HalfDay => "bg-info text-dark",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @badgeClass">@item.Status</span>
                    </td>
                    <td>@item.InTime?.ToString(@"hh\:mm")</td>
                    <td>@item.OutTime?.ToString(@"hh\:mm")</td>
                    <td>
                        @{
                            TimeSpan? worked = null;
                            if (item.InTime.HasValue && item.OutTime.HasValue)
                            {
                                var diff = item.OutTime.Value - item.InTime.Value;
                                if (diff < TimeSpan.Zero) diff += TimeSpan.FromHours(24);
                                worked = diff;
                            }
                        }
                        @(worked.HasValue ? $"{(int)worked.Value.TotalHours:00}h {worked.Value.Minutes:00}m" : "-")
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!paged.Items.Any())
{
    <div class="alert alert-secondary">No attendance records found.</div>
}

@{
    var pagination = new DLAttendance.ViewModels.PaginationViewModel
    {
        Page = paged.Page,
        PageSize = paged.PageSize,
        TotalCount = paged.TotalCount,
        Controller = "Profile",
        Action = "MyAttendance",
        RouteValues = new Dictionary<string, string?>
        {
            ["fromDate"] = Model.FromDate?.ToString("yyyy-MM-dd"),
            ["toDate"] = Model.ToDate?.ToString("yyyy-MM-dd"),
            ["status"] = Model.Status
        }
    };
}
<partial name="_Pagination" model="pagination" />
