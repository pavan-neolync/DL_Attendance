@model DLAttendance.ViewModels.UserEditViewModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<input type="hidden" asp-for="Id" />

<div class="mb-3">
    <label asp-for="UserName" class="form-label"></label>
    <input asp-for="UserName" class="form-control" />
    <span asp-validation-for="UserName" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Password" class="form-label"></label>
    <input asp-for="Password" class="form-control" />
    <span asp-validation-for="Password" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="EmployeeCode" class="form-label"></label>
    <select asp-for="EmployeeCode" class="form-select">
        <option value="">-- No Employee Linked --</option>
        @foreach (var emp in Model.AvailableEmployees)
        {
            <option value="@emp.Value" selected="@emp.Selected">@emp.Text</option>
        }
    </select>
    <div class="form-text text-muted">Link this user to a DL Employee record (required for Viewer role).</div>
    <span asp-validation-for="EmployeeCode" class="text-danger"></span>
</div>

<fieldset class="mb-3">
    <legend class="h6">Roles</legend>
    <div class="d-flex flex-wrap gap-3">
        @foreach (var role in Model.AvailableRoles)
        {
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="SelectedRoles" value="@role.Value" id="role_@role.Value" checked="@role.Selected" />
                <label class="form-check-label" for="role_@role.Value">@role.Text</label>
            </div>
        }
    </div>
</fieldset>
